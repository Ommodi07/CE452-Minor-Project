ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

GEMINI_API_KEY=
DEFAULT_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=256
GROQ_API_KEY=
